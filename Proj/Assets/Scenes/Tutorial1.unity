--- !u!114 &314257658
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 314257657}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<font-weight=800><color=#FFFFFF>Mana</color></font-weight> is a <font-weight=800><color=#FFFFFF>shared
    resource</color></font-weight> used to play <font-weight=800><color=#FFFFFF>Cards</color></font-weight>
    during <font-weight=800><color=#FFFFFF>combat</color></font-weight>. Mana is
    <font-weight=800><color=#FFFFFF>gained passively</color></font-weight> at the
    start of every <font-weight=800><color=#FFFFFF>ally character\u2019s turn</color></font-weight>,
    and can also be <font-weight=800><color=#FFFFFF>generated</color></font-weight>
    by <font-weight=800><color=#FFFFFF>abilities</color></font-weight> or <font-weight=800><color=#FFFFFF>card
    effects</color></font-weight>.\r\nPlaying a <font-weight=800><color=#FFFFFF>card</color></font-weight>
    consumes <font-weight=800><color=#FFFFFF>Mana</color></font-weight>. If you lack
    <font-weight=800><color=#FFFFFF>sufficient Mana</color></font-weight>, the card
    <font-weight=800><color=#FFFFFF>cannot be used</color></font-weight>. The Mana
    <font-weight=800><color=#FFFFFF>cost</color></font-weight> shown on a card provides
    <font-weight=800><color=#FFFFFF>immediate feedback</color></font-weight>:\r\n
    \u2022 If the cost is shown in <font-weight=800><color=#FFFFFF>red</color></font-weight>,
    you cannot afford to <font-weight=800><color=#FFFFFF>play the card</color></font-weight>.\r\n
    \u2022 If the cost is shown in <font-weight=800><color=#FFFFFF>green</color></font-weight>,
    the card\u2019s cost has been <font-weight=800><color=#FFFFFF>reduced</color></font-weight>
    by the effect of other <font-weight=800><color=#FFFFFF>cards</color></font-weight>,
    <font-weight=800><color=#FFFFFF>abilities</color></font-weight>, or <font-weight=800><color=#FFFFFF>traits</color></font-weight>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
    type: 2}
