      m_Calls: []
  m_text: 'Before <font-weight=800><color=#FFFFFF>combat begins</color></font-weight>,
    you must <font-weight=800><color=#FFFFFF>place your heroes</color></font-weight>
    on the <font-weight=800><color=#FFFFFF>battlefield</color></font-weight>. Click
    <font-weight=800><color=#FFFFFF>(M1)</color></font-weight> on a <font-weight=800><color=#FFFFFF>character</color></font-weight>
    to <font-weight=800><color=#FFFFFF>select</color></font-weight> them, then click
    <font-weight=800><color=#FFFFFF>(M1)</color></font-weight> on any <font-weight=800><color=#FFFFFF>green
    starting tile</color></font-weight> to place them.

    

    <font-weight=800><color=#FFFFFF>Positioning
    matters</color></font-weight>. <font-weight=800><color=#FFFFFF>Frontline fighters</color></font-weight>
    should <font-weight=800><color=#FFFFFF>protect vulnerable allies</color></font-weight>,
    while <font-weight=800><color=#FFFFFF>ranged heroes</color></font-weight> benefit
    from <font-weight=800><color=#FFFFFF>distance</color></font-weight> and <font-weight=800><color=#FFFFFF>clear
    lines of sight</color></font-weight>. You may <font-weight=800><color=#FFFFFF>freely
    reposition</color></font-weight> characters during this phase. There is <font-weight=800><color=#FFFFFF>no
    penalty</color></font-weight> for <font-weight=800><color=#FFFFFF>experimentation</color></font-weight>.

    

    When
    all <font-weight=800><color=#FFFFFF>characters are placed</color></font-weight>
    and you are <font-weight=800><color=#FFFFFF>satisfied with your formation</color></font-weight>,
    press <font-weight=800><color=#FFFFFF>Spacebar</color></font-weight> or click
    <font-weight=800><color=#FFFFFF>Start Combat</color></font-weight> to begin.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
