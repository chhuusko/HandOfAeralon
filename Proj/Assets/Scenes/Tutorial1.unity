      m_Calls: []
  m_text: "<font-weight=800><color=#FFFFFF>Abilities</color></font-weight> are a
    character\u2019s primary tools in <font-weight=800><color=#FFFFFF>combat</color></font-weight>.
    A character can only <font-weight=800><color=#FFFFFF>move</color></font-weight>
    before using an <font-weight=800><color=#FFFFFF>ability</color></font-weight>.
    Once an ability is used, all the character\u2019s remaining <font-weight=800><color=#FFFFFF>MP</color></font-weight>
    is spent; unless the ability explicitly states otherwise. At the start of their
    next turn, a character\u2019s MP is reset to their <font-weight=800><color=#FFFFFF>maximum</color></font-weight>.\r\n\r\nUnless
    stated otherwise, a character may use <font-weight=800><color=#FFFFFF>one ability
    per turn</color></font-weight>. Each class has <font-weight=800><color=#FFFFFF>four
    unique abilities</color></font-weight>, defining their role on the <font-weight=800><color=#FFFFFF>battlefield</color></font-weight>.\r\n\r\n<font-weight=800><color=#FFFFFF>Abilities
    may:</color></font-weight>\r\n \u2022 <font-weight=800><color=#FFFFFF>Deal damage</color></font-weight>
    or <font-weight=800><color=#FFFFFF>heal</color></font-weight>  \r\n \u2022 Affect
    a <font-weight=800><color=#FFFFFF>single target</color></font-weight> or characters
    in a <font-weight=800><color=#FFFFFF>larger area</color></font-weight>  \r\n
    \u2022 Apply or remove <font-weight=800><color=#FFFFFF>buffs</color></font-weight>
    or <font-weight=800><color=#FFFFFF>debuffs</color></font-weight>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
