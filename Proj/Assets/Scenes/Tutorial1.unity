  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Your <font-weight=800><color=#FFFFFF>deck</color></font-weight> represents
    all <font-weight=800><color=#FFFFFF>cards</color></font-weight> available to
    you during a <font-weight=800><color=#FFFFFF>run</color></font-weight>. In <font-weight=800><color=#FFFFFF>combat</color></font-weight>,
    the deck is divided into <font-weight=800><color=#FFFFFF>two piles</color></font-weight>:\r\n
    \u2022 <font-weight=800><color=#FFFFFF>Draw Pile</color></font-weight>: where
    cards are <font-weight=800><color=#FFFFFF>drawn</color></font-weight> from\r\n
    \u2022 <font-weight=800><color=#FFFFFF>Discard Pile</color></font-weight>: where
    <font-weight=800><color=#FFFFFF>played</color></font-weight> or <font-weight=800><color=#FFFFFF>discarded
    cards</color></font-weight> go\r\nYou can click <font-weight=800><color=#FFFFFF>(M1)</color></font-weight>
    on the <font-weight=800><color=#FFFFFF>Draw Pile</color></font-weight> or <font-weight=800><color=#FFFFFF>Discard
    Pile</color></font-weight> at any time to <font-weight=800><color=#FFFFFF>view
    the cards</color></font-weight> currently inside them. The cards shown in the
    <font-weight=800><color=#FFFFFF>Draw Pile</color></font-weight> are displayed
    in a <font-weight=800><color=#FFFFFF>random order</color></font-weight> and do
    not reflect the <font-weight=800><color=#FFFFFF>order</color></font-weight> in
    which they will be drawn.\r\nEach <font-weight=800><color=#FFFFFF>pile</color></font-weight>
    displays a <font-weight=800><color=#FFFFFF>number</color></font-weight>, indicating
    how many <font-weight=800><color=#FFFFFF>cards</color></font-weight> it currently
    contains. When the <font-weight=800><color=#FFFFFF>Draw Pile</color></font-weight>
    is <font-weight=800><color=#FFFFFF>empty</color></font-weight>, the <font-weight=800><color=#FFFFFF>Discard
    Pile</color></font-weight> is <font-weight=800><color=#FFFFFF>shuffled</color></font-weight>
    back into the <font-weight=800><color=#FFFFFF>Draw Pile</color></font-weight>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
