--- !u!114 &292398591
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 292398590}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<font-weight=800><color=#FFFFFF>Cards</color></font-weight> have <font-weight=800><color=#FFFFFF>powerful
    effects</color></font-weight> and may be <font-weight=800><color=#FFFFFF>played</color></font-weight>
    during any <font-weight=800><color=#FFFFFF>ally\u2019s turn</color></font-weight>.
    To <font-weight=800><color=#FFFFFF>use a card</color></font-weight>, <font-weight=800><color=#FFFFFF>drag</color></font-weight>
    it from your <font-weight=800><color=#FFFFFF>hand</color></font-weight> onto
    the <font-weight=800><color=#FFFFFF>battlefield</color></font-weight>. If the
    card is <font-weight=800><color=#FFFFFF>targetable</color></font-weight>, you
    may <font-weight=800><color=#FFFFFF>place</color></font-weight> it on any <font-weight=800><color=#FFFFFF>valid
    tile</color></font-weight>, depending on its <font-weight=800><color=#FFFFFF>effect</color></font-weight>,
    to choose where its effect is <font-weight=800><color=#FFFFFF>applied</color></font-weight>.
    \r\nCards <font-weight=800><color=#FFFFFF>deal damage</color></font-weight> that
    is neither <font-weight=800><color=#FFFFFF>Physical</color></font-weight> or
    <font-weight=800><color=#FFFFFF>Elemental</color></font-weight>, so it is <font-weight=800><color=#FFFFFF>unaffected</color></font-weight>
    by effects that <font-weight=800><color=#FFFFFF>increase</color></font-weight>
    or <font-weight=800><color=#FFFFFF>reduce</color></font-weight> those <font-weight=800><color=#FFFFFF>damage
    types</color></font-weight>.\r\nYou <font-weight=800><color=#FFFFFF>draw 1 card</color></font-weight>
    at the start of every <font-weight=800><color=#FFFFFF>4 ally character\u2019s
    turns</color></font-weight>, marked in the <font-weight=800><color=#FFFFFF>Turn
    Order Panel</color></font-weight>. Your <font-weight=800><color=#FFFFFF>hand</color></font-weight>
    has a <font-weight=800><color=#FFFFFF>maximum size</color></font-weight> of <font-weight=800><color=#FFFFFF>10
    cards</color></font-weight>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
