  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This is the <font-weight=800><color=#FFFFFF>Info Panel</color></font-weight>,
    here you\u2019ll find the <font-weight=800><color=#FFFFFF>character\u2019s name</color></font-weight>,
    <font-weight=800><color=#FFFFFF>class</color></font-weight>, <font-weight=800><color=#FFFFFF>traits</color></font-weight>,
    <font-weight=800><color=#FFFFFF>stats</color></font-weight> and all <font-weight=800><color=#FFFFFF>status
    effects</color></font-weight> currently affecting them.\r\nEvery <font-weight=800><color=#FFFFFF>character</color></font-weight>
    has:\r\n \u2022 <font-weight=800><color=#FFFFFF>One positive trait</color></font-weight>\r\n
    \u2022 <font-weight=800><color=#FFFFFF>One negative trait</color></font-weight>\r\n<font-weight=800><color=#FFFFFF>Traits</color></font-weight>
    can <font-weight=800><color=#FFFFFF>modify stats</color></font-weight>, <font-weight=800><color=#FFFFFF>alter
    ability behavior</color></font-weight>, or <font-weight=800><color=#FFFFFF>introduce
    conditional effects</color></font-weight>.\r\n<font-weight=800><color=#FFFFFF>Class-specific
    traits</color></font-weight> are more <font-weight=800><color=#FFFFFF>rare</color></font-weight>
    and often more <font-weight=800><color=#FFFFFF>powerful positive traits</color></font-weight>,
    shaping <font-weight=800><color=#FFFFFF>unique playstyles</color></font-weight>."
