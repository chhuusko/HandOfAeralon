    m_PersistentCalls:
      m_Calls: []
  m_text: '<font-weight=800><color=#FFFFFF>Hovering (M1)</color></font-weight> over
    an <font-weight=800><color=#FFFFFF>ability</color></font-weight> opens its <font-weight=800><color=#FFFFFF>tooltip</color></font-weight>,
    displaying <font-weight=800><color=#FFFFFF>detailed information</color></font-weight>.
    If you hover over a tooltip long enough, it will <font-weight=800><color=#FFFFFF>lock
    in place</color></font-weight>, allowing you to <font-weight=800><color=#FFFFFF>move
    the cursor freely</color></font-weight> and inspect <font-weight=800><color=#FFFFFF>additional
    details</color></font-weight> without the tooltip disappearing. The <font-weight=800><color=#FFFFFF>hover
    time</color></font-weight> required to lock a tooltip can be adjusted in the
    <font-weight=800><color=#FFFFFF>Settings Menu</color></font-weight>.



    <font-weight=800><color=#FFFFFF>Highlighted
    keywords</color></font-weight> inside tooltips can be hovered over to reveal
    <font-weight=800><color=#FFFFFF>deeper explanations</color></font-weight> of
    mechanics such as <font-weight=800><color=#FFFFFF>Buffs</color></font-weight>,
    <font-weight=800><color=#FFFFFF>Debuffs</color></font-weight>, or <font-weight=800><color=#FFFFFF>special
    rules</color></font-weight>.



    <font-weight=800><color=#FFFFFF>Damage values</color></font-weight>
    shown in abilities can also be hovered over to see the <font-weight=800><color=#FFFFFF>full
    damage calculation</color></font-weight>, including modifiers from <font-weight=800><color=#FFFFFF>stats</color></font-weight>,
    <font-weight=800><color=#FFFFFF>traits</color></font-weight>, and <font-weight=800><color=#FFFFFF>active
    effects</color></font-weight>. <font-weight=800><color=#FFFFFF>Mastering keywords</color></font-weight>
    is essential for understanding <font-weight=800><color=#FFFFFF>more complex interactions</color></font-weight>.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
