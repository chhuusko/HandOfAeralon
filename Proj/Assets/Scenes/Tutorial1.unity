MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 503590293}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When <font-weight=800><color=#FFFFFF>selecting an ability</color></font-weight>
    using <font-weight=800><color=#FFFFFF>M1</color></font-weight>, <font-weight=800><color=#FFFFFF>valid
    tiles</color></font-weight> for the ability are highlighted on the battlefield
    in <font-weight=800><color=#FFFFFF>light blue</color></font-weight>. <font-weight=800><color=#FFFFFF>Hovering</color></font-weight>
    over one of these tiles previews the <font-weight=800><color=#FFFFFF>result of
    the ability</color></font-weight> before committing.\r\n\r\nTiles that the ability
    will <font-weight=800><color=#FFFFFF>affect</color></font-weight> are highlighted
    in <font-weight=800><color=#FFFFFF>red</color></font-weight>, clearly showing
    the <font-weight=800><color=#FFFFFF>area of impact</color></font-weight>. Any
    <font-weight=800><color=#FFFFFF>characters</color></font-weight> that would be
    affected by the ability display a <font-weight=800><color=#FFFFFF>yellow effect
    indicator</color></font-weight> beneath them, allowing you to quickly see who
    will be <font-weight=800><color=#FFFFFF>hit</color></font-weight>, <font-weight=800><color=#FFFFFF>healed</color></font-weight>,
    or <font-weight=800><color=#FFFFFF>influenced</color></font-weight>.\r\n\r\nWhile
    hovering, <font-weight=800><color=#FFFFFF>expected damage</color></font-weight>
    is previewed directly on the enemy\u2019s <font-weight=800><color=#FFFFFF>health
    bar</color></font-weight>, including all <font-weight=800><color=#FFFFFF>current
    modifiers</color></font-weight>. Use this preview to <font-weight=800><color=#FFFFFF>plan
    ahead</color></font-weight>; especially when <font-weight=800><color=#FFFFFF>positioning</color></font-weight>,
    <font-weight=800><color=#FFFFFF>chaining abilities and cards</color></font-weight>,
    or to swiftly tell if an attack might <font-weight=800><color=#FFFFFF>finish
    off an enemy</color></font-weight>.\r\n\r\nSome abilities have specific <font-weight=800><color=#FFFFFF>patterns</color></font-weight>,
    <font-weight=800><color=#FFFFFF>ranges</color></font-weight>, or <font-weight=800><color=#FFFFFF>restrictions</color></font-weight>
    that require <font-weight=800><color=#FFFFFF>careful planning</color></font-weight>
    to get the most out of them.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
