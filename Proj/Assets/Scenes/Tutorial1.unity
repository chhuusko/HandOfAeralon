  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Combat proceeds according to the <font-weight=800><color=#FFFFFF>Turn
    Order Panel</color></font-weight> shown on the screen. Units act from left to
    right based on their <font-weight=800><color=#FFFFFF>Initiative</color></font-weight>
    stat. <font-weight=800><color=#FFFFFF>Higher Initiative</color></font-weight>
    means <font-weight=800><color=#FFFFFF>acting earlier</color></font-weight> in
    the round. If two or more units have the same Initiative, their order is decided
    by a <font-weight=800><color=#FFFFFF>coin flip</color></font-weight> at the start
    of the round.



    The <font-weight=800><color=#FFFFFF>currently active character</color></font-weight>
    is displayed in a <font-weight=800><color=#FFFFFF>separate box to the left</color></font-weight>
    of the Turn Order Panel, making it clear whose turn it is at all times. You can
    click any unit in the turn order to select that character. Initiative and other
    stats will soon be explained in more detail.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
