    - target: {fileID: 1788940844840018203, guid: 2256ce73421755a45912b2f2e87e9884,
        type: 3}
      propertyPath: m_text
      value: "{ability}Abilities{/ability} are a character\u2019s primary tools in
        combat. A character may use one {ability}ability{/ability} per turn. \\n\r\nA
        character can only <font-weight=800><color=#FFFFFF>move before</color></font-weight>
        using an {ability}ability{/ability}, unless the {ability}ability{/ability}
        explicitly states otherwise. \\n\r\nEach class has four unique {ability}abilities{/ability},
        defining their role on the battlefield. \\n\r\n{ability}Abilities{/ability}
        may:\r\n \u2022 Deal {physical_damage}damage{/physical_damage} or {heal}heal{/heal}\r\n
        \u2022 Affect a single target or characters in a larger area\r\n \u2022 Apply
        or remove buffs or debuffs"
