  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "On their <font-weight=800><color=#FFFFFF>turn</color></font-weight>, a
    <font-weight=800><color=#FFFFFF>character</color></font-weight> may <font-weight=800><color=#FFFFFF>move</color></font-weight>
    across the <font-weight=800><color=#FFFFFF>battlefield</color></font-weight>
    using <font-weight=800><color=#FFFFFF>Movement Points (MP)</color></font-weight>.
    At the start of their <font-weight=800><color=#FFFFFF>next turn</color></font-weight>,
    the character\u2019s MP is <font-weight=800><color=#FFFFFF>reset</color></font-weight>
    to its <font-weight=800><color=#FFFFFF>maximum</color></font-weight>. When the
    active reach using their <font-weight=800><color=#FFFFFF>remaining MP</color></font-weight>.\n\r\nMoving
    costs <font-weight=800><color=#FFFFFF>MP</color></font-weight> based on <font-weight=800><color=#FFFFFF>distance</color></font-weight>
    and <font-weight=800><color=#FFFFFF>direction</color></font-weight>:\r\n \u2022
    <font-weight=800><color=#FFFFFF>Moving one tile</color></font-weight> costs <font-weight=800><color=#FFFFFF>1
    MP</color></font-weight>\r\n \u2022 <font-weight=800><color=#FFFFFF>Moving diagonally</color></font-weight>
    costs <font-weight=800><color=#FFFFFF>2 MP</color></font-weight>\n\r\nSelect
    a <font-weight=800><color=#FFFFFF>character</color></font-weight> with <font-weight=800><color=#FFFFFF>M1</color></font-weight>.
    While a character is selected, you may press <font-weight=800><color=#FFFFFF>M2</color></font-weight>
    to <font-weight=800><color=#FFFFFF>cancel the selection</color></font-weight>.
    With a character selected, click <font-weight=800><color=#FFFFFF>(M1)</color></font-weight>
    on any <font-weight=800><color=#FFFFFF>highlighted tile</color></font-weight>
    to <font-weight=800><color=#FFFFFF>move</color></font-weight>. An <font-weight=800><color=#FFFFFF>MP
    indicator</color></font-weight> is displayed beside the <font-weight=800><color=#FFFFFF>Ability
    Panel</color></font-weight>, showing the character\u2019s <font-weight=800><color=#FFFFFF>current
    MP</color></font-weight> and <font-weight=800><color=#FFFFFF>maximum MP</color></font-weight>
    at all times, as well as <font-weight=800><color=#FFFFFF>previewing the cost</color></font-weight>
    of moving to the <font-weight=800><color=#FFFFFF>currently hovered tile</color></font-weight>.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
