    - target: {fileID: 187673725096014526, guid: 2256ce73421755a45912b2f2e87e9884,
        type: 3}
      propertyPath: m_text
      value: "The Combat Log records what happens in the battle, including <font-weight=800><color=#FFFFFF>effects
        applied</color></font-weight> to characters, {physical_damage}damage dealt{/physical_damage},
        {heal}healing done{/heal}, {card}cards used{/card}, and character <font-weight=800><color=#FFFFFF>deaths</color></font-weight>.\\n\r\nClicking
        <font-weight=800><color=#FFFFFF>(M1)</color></font-weight> on a character\u2019s
        name in the log will immediately selects that character on the battlefield."
      objectReference: {fileID: 0}
    - target: {fileID: 215927754732561091, guid: 2256ce73421755a45912b2f2e87e9884,
        type: 3}
      propertyPath: m_AnchorMax.y
