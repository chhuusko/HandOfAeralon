    - target: {fileID: 4984218298821186459, guid: 2256ce73421755a45912b2f2e87e9884,
        type: 3}
      propertyPath: m_text
      value: 'The shop offers {card}individual cards{/card}, as well as {card}card
        packs{/card}.\n

        {card}Card packs{/card} allow you to <font-weight=800><color=#FFFFFF>select
        two</color></font-weight> {card}cards{/card} from a <font-weight=800><color=#FFFFFF>set
        of five</color></font-weight>, offering strategic choice mixed with randomness.\n

        You
        may also pay to <font-weight=800><color=#FFFFFF>refresh the shop</color></font-weight>.
        Refreshing fully <font-weight=800><color=#FFFFFF>restocks</color></font-weight>
        the shop, replacing all current offerings, including any items you have already
        purchase, with a <font-weight=800><color=#FFFFFF>new random selection</color></font-weight>
        of characters, {card}cards{/card}, and packs.'
      objectReference: {fileID: 0}
