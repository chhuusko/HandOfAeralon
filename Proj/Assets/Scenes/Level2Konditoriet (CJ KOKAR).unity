    - target: {fileID: 3102037978806972859, guid: 2256ce73421755a45912b2f2e87e9884,
        type: 3}
      propertyPath: m_text
      value: "Combat is viewed through a <font-weight=800><color=#FFFFFF>3D strategic
        camera</color></font-weight> designed to clearly communicate unit positions,
        threats, and terrain without unnecessary complexity. \\n \nYou can move the
        camera to survey the battlefield using WASD or holding down Mouse Scroll
        Wheel. \\n\nAdjust your view by <font-weight=800><color=#FFFFFF>scrolling
        the Mouse Scroll Wheel</color></font-weight> to zoom in and out within a
        limited range."
      objectReference: {fileID: 0}
