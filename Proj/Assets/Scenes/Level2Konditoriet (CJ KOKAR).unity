    - target: {fileID: 7296483785123092559, guid: 2256ce73421755a45912b2f2e87e9884,
        type: 3}
      propertyPath: m_text
      value: 'The <font-weight=800><color=#FFFFFF>Deck</color></font-weight> button
        allows you to <font-weight=800><color=#FFFFFF>view all</color></font-weight>
        {card}cards{/card} currently in your deck.\n

        You may pay gold to
        permanently {card}remove cards{/card} you no longer want. The <font-weight=800><color=#FFFFFF>cost
        increases</color></font-weight> each time you remove a {card}card{/card}
        during the same shop visit.\n

        Removing unwanted {card}cards{/card}
        can <font-weight=800><color=#FFFFFF>help focus your deck</color></font-weight>,
        making it easier to draw the {card}cards{/card} that best fit your strategy.'
      objectReference: {fileID: 0}
