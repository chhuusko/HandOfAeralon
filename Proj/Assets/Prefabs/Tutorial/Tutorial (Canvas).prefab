  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When selecting an {ability}ability{/ability} using <font-weight=800><color=#FFFFFF>M1</color></font-weight>,
    <font-weight=800><color=#FFFFFF>valid tiles</color></font-weight> for the {ability}ability{/ability}
    are highlighted on the battlefield in <font-weight=800><color=#FFFFFF>orange</color></font-weight>.
    Hovering over one of these tiles previews the result of the {ability}ability{/ability}
    before committing. \r\nTiles that the {ability}ability{/ability} will <font-weight=800><color=#FFFFFF>affect</color></font-weight>
    are highlighted in <font-weight=800><color=#FFFFFF>red</color></font-weight>,
    clearly showing the area of impact. Any characters that would be <font-weight=800><color=#FFFFFF>affected</color></font-weight>
    by the {ability}ability{/ability} display a <font-weight=800><color=#FFFFFF>yellow
    effect indicator beneath them</color></font-weight>, allowing you to quickly
    see who will be hit, {heal}healed{/heal}, or influenced.\r\nWhile hovering, expected
    {physical_damage}damage{/physical_damage} is previewed directly on the enemy\u2019s
    {heal}health bar{/heal}, including all current modifiers. Use this preview to
    plan ahead; especially when positioning, chaining {ability}abilities{/ability}
    and {card}cards{/card}, or to swiftly tell if an attack might finish off an enemy.\r\nAt
    any point during targeting or preview, press <font-weight=800><color=#FFFFFF>M2</color></font-weight>
    to cancel the selection and preview. Some {ability}abilities{/ability} have specific
    patterns, ranges, or restrictions that require careful planning to get the most
    out of them."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
