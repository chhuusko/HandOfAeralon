  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The <font-weight=800><color=#FFFFFF>Deck</color></font-weight> button
    allows you to <font-weight=800><color=#FFFFFF>view all</color></font-weight>
    {card}cards{/card} currently in your deck.

    You may pay gold to permanently
    {card}remove cards{/card} you no longer want. The <font-weight=800><color=#FFFFFF>cost
    increases</color></font-weight> each time you remove a {card}card{/card} during
    the same shop visit.

    Removing unwanted {card}cards{/card} can <font-weight=800><color=#FFFFFF>help
    focus your deck</color></font-weight>, making it easier to draw the {card}cards{/card}
    that best fit your strategy.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
