  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Your deck represents all {card}cards{/card} available to you during a
    run. In combat, the deck is divided into two piles:\r\n \u2022 <font-weight=800><color=#FFFFFF>Draw
    Pile</color></font-weight>: where {card}cards{/card} are drawn from\r\n \u2022
    <font-weight=800><color=#FFFFFF>Discard Pile</color></font-weight>: where played
    or {card}discarded cards{/card} go\r\nYou can <font-weight=800><color=#FFFFFF>click
    (M1)</color></font-weight> on the <font-weight=800><color=#FFFFFF>Draw Pile</color></font-weight>
    or <font-weight=800><color=#FFFFFF>Discard Pile</color></font-weight> at any
    time to view the {card}cards{/card} currently inside them. The {card}cards{/card}
    shown in the {card}Draw Pile{/card} are displayed in a <font-weight=800><color=#FFFFFF>random
    order</color></font-weight> and do <font-weight=800><color=#FFFFFF>not</color></font-weight>
    reflect the order in which they will be drawn.\r\nEach pile displays a <font-weight=800><color=#FFFFFF>number</color></font-weight>,
    indicating how many {card}cards{/card} it currently contains. When the {card}Draw
    Pile{/card} is empty, the {card}Discard Pile{/card} is <font-weight=800><color=#FFFFFF>shuffled</color></font-weight>
    back into the {card}Draw Pile{/card}."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
