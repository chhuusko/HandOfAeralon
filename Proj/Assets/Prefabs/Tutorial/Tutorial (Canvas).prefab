  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "{card}Cards{/card} have powerful effects and may be played during any
    ally\u2019s turn. To use a {card}card{/card}, <font-weight=800><color=#FFFFFF>drag
    it from your hand onto the battlefield</color></font-weight>. If the {card}card{/card}
    is <font-weight=800><color=#FFFFFF>targetable</color></font-weight>, you may
    place it on <font-weight=800><color=#FFFFFF>any valid tile</color></font-weight>,
    depending on its effect, to choose where its effect is applied. \r\n{card}Cards{/card}
    deal {physical_damage}damage{/physical_damage} that <font-weight=800><color=#FFFFFF>is
    neither</color></font-weight> {physical_damage}Physical{/physical_damage} <font-weight=800><color=#FFFFFF>or</color></font-weight>
    {elemental_damage}Elemental{/elemental_damage}, so it is <font-weight=800><color=#FFFFFF>unaffected
    by effects that increase or reduce those</color></font-weight> {physical_damage}damage
    types{/physical_damage}.\r\nYou draw <font-weight=800><color=#FFFFFF>1</color></font-weight>
    {card}card{/card} <font-weight=800><color=#FFFFFF>at the start of every 4 ally
    character\u2019s turns</color></font-weight>, marked in the <font-weight=800><color=#FFFFFF>Turn
    Order Panel</color></font-weight>. Your hand has a <font-weight=800><color=#FFFFFF>maximum
    size of 10</color></font-weight> {card}cards{/card}."
