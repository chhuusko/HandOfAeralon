  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "On their turn, a character may move across the battlefield using <font-weight=800><color=#FFFFFF>Movement
    Points (MP)</color></font-weight>. At the start of their next turn, the character\u2019s
    MP is reset to its maximum. When the active reach using their <font-weight=800><color=#FFFFFF>remaining
    MP</color></font-weight>.\r\nMoving costs MP based on distance and direction:\r\n
    \u2022 Moving <font-weight=800><color=#FFFFFF>one tile</color></font-weight>
    costs <font-weight=800><color=#FFFFFF>1 MP</color></font-weight>\r\n \u2022 Moving
    <font-weight=800><color=#FFFFFF>diagonally</color></font-weight> costs <font-weight=800><color=#FFFFFF>2
    MP</color></font-weight>\r\nSelect a character with <font-weight=800><color=#FFFFFF>M1</color></font-weight>,
    you may press <font-weight=800><color=#FFFFFF>M2</color></font-weight> to cancel
    the selection. While a character is selected, <font-weight=800><color=#FFFFFF>green
    tiles</color></font-weight> appear on the grid, showing all tiles that character
    can move to. With a character selected, click <font-weight=800><color=#FFFFFF>(M1)</color></font-weight>
    on any highlighted tile to move. An <font-weight=800><color=#FFFFFF>MP indicator</color></font-weight>
    is displayed beside the {ability}Ability Panel{/ability}, showing the character\u2019s
    <font-weight=800><color=#FFFFFF>current MP and maximum MP</color></font-weight>
    at all times, as well as previewing the cost of moving to the currently hovered
    tile."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
