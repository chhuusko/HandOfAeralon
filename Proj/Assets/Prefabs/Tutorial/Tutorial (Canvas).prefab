  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Here you can also view a character\u2019s full stat breakdown, including
    {heal}Health{/heal}, {physical_damage}Damage{/physical_damage}, <font-weight=800><color=#FFFFFF>Initiative</color></font-weight>,
    and <font-weight=800><color=#FFFFFF>Movement Points (MP)</color></font-weight>;
    which can all be <font-weight=800><color=#FFFFFF>modified</color></font-weight>
    by <font-weight=800><color=#FFFFFF>traits</color></font-weight> and <font-weight=800><color=#FFFFFF>status
    effects</color></font-weight>.\r\n{heal}Health{/heal} determines how much {physical_damage}damage{/physical_damage}
    a character can take. If a character\u2019s {heal}Health{/heal} reaches <font-weight=800><color=#FFFFFF>0</color></font-weight>,
    they are <font-weight=800><color=#FFFFFF>permanently dead</color></font-weight>.
    {heal}Health{/heal} can be restored through {ability}abilities{/ability}, {card}cards{/card},
    or in the shop.\r\n{physical_damage}Damage{/physical_damage} represents the character\u2019s
    base {physical_damage}damage{/physical_damage} value. {ability}Ability{/ability}
    {physical_damage}damage{/physical_damage} multipliers scale from this stat. \r\n<font-weight=800><color=#FFFFFF>Initiative</color></font-weight>
    determines <font-weight=800><color=#FFFFFF>turn order</color></font-weight> each
    round; characters act from <font-weight=800><color=#FFFFFF>highest to lowest</color></font-weight>,
    and the order <font-weight=800><color=#FFFFFF>updates</color></font-weight> if
    <font-weight=800><color=#FFFFFF>Initiative changes</color></font-weight> during
    combat.\r\n<font-weight=800><color=#FFFFFF>Movement Points (MP)</color></font-weight>
    determine how many tiles a character can move during their turn."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
