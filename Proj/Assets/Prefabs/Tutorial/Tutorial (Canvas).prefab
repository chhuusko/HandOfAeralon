  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Welcome to <font-weight=800><color=#FFFFFF>Hand of Aeralon</color></font-weight>,
    a <font-weight=800><color=#FFFFFF>turn-based tactical RPG</color></font-weight>
    with <font-weight=800><color=#FFFFFF>card- and party-driven combat</color></font-weight>.

    You
    play as <font-weight=800><color=#FFFFFF>Archmage Aeralon</color></font-weight>,
    an unseen ruler bound by secrecy. Unable to act directly, you command a party
    of heroes on grid-based battlefields and influence combat through powerful arcane
    {card}Cards{/card}.

    Nimurath is under siege by the <font-weight=800><color=#FFFFFF>Nere</color></font-weight>,
    empowered by <font-weight=800><color=#FFFFFF>Magor, God of Chaos</color></font-weight>.
    To stop his return, you must guide your heroes through a series of increasingly
    dangerous encounters.

    Each battle is part of a larger run. Heroes can die
    permanently, resources are limited, and enemies grow stronger. Victory demands
    smart positioning, careful planning, and decisive use of {ability}abilities{/ability}
    and {card}cards{/card}.

    This tutorial will teach you the fundamentals. Every
    decision matters.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6bd24cd4d3d515d48bd7ad1def33fa09, type: 2}
  m_sharedMaterial: {fileID: -5814162066966551001, guid: 6bd24cd4d3d515d48bd7ad1def33fa09,
