  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "{mana}Mana{/mana} is a shared resource used to play {card}Cards{/card}
    during combat. {mana}Mana{/mana} is gained passively at the start of <font-weight=800><color=#FFFFFF>every
    ally character\u2019s turn</color></font-weight>, and can also be generated by
    {ability}abilities{/ability} or {card}card{/card} effects.\r\nPlaying a {card}card{/card}
    consumes {mana}Mana{/mana}. If you lack sufficient {mana}Mana{/mana}, the {card}card{/card}
    cannot be used. The {mana}Mana cost{/mana} shown on a {card}card{/card} provides
    immediate feedback:\r\n \u2022 If the cost is shown in <font-weight=800><color=#FFFFFF>red</color></font-weight>,
    you <font-weight=800><color=#FFFFFF>cannot afford</color></font-weight> to play
    the {card}card{/card}.\r\n \u2022 If the cost is shown in <font-weight=800><color=#FFFFFF>green</color></font-weight>,
    the {card}card\u2019s cost{/card} has been <font-weight=800><color=#FFFFFF>reduced</color></font-weight>
    by the effect of other {card}cards{/card}, {ability}abilities{/ability}, or traits."
